# Mapbox: token público (pk.*) para el mapa de /buscar y la geocodificación.
# Si falta, /buscar muestra solo el listado, sin mapa.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública para canonical, sitemap y datos estructurados (sin barra final).
NEXT_PUBLIC_SITE_URL=https://homeandheart.es

NEXT_PUBLIC_URL=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Modo cerrado de pagos reales: lista de emails (coma) que pueden iniciar pagos.
# Si falta o está vacía, los pagos quedan abiertos a todos.
# PAGOS_SOLO_EMAILS=tu@email.com,socio@email.com
PAGOS_SOLO_EMAILS=
